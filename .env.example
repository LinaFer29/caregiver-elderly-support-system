# Variables compartidas para Docker Compose y Django.
# Copia este archivo a `.env` en la raiz del proyecto y reemplaza los valores.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.example.com,localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

MQTT_USER=replace-with-mqtt-user
MQTT_PASSWORD=replace-with-mqtt-password
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=60

FRONTEND_HOST_PORT=18080
VITE_API_URL=/api/v1
